+// Copyright (c) rAthena Dev Teams - Licensed under GNU GPL
+// For more information, see LICENCE in the main folder
+
+#include "typhoonwing.hpp"
+
+#include "map/clif.hpp"
+#include "map/status.hpp"
+
+SkillTyphoonWing::SkillTyphoonWing() : SkillImplRecursiveDamageSplash(KR_TYPHOON_WING) {
+}
+
+void SkillTyphoonWing::castendDamageId(block_list* src, block_list* target, uint16 skill_lv, t_tick tick, int32& flag) const {
+	if (!(flag & 1)) {
+		clif_skill_nodamage(src, *target, getSkillId(), skill_lv);
+	}
+
+	SkillImplRecursiveDamageSplash::castendDamageId(src, target, skill_lv, tick, flag);
+}
+
+void SkillTyphoonWing::calculateSkillRatio(const Damage* wd, const block_list* src, const block_list* target, uint16 skill_lv, int32& base_skillratio, int32 mflag) const {
+	const status_change* sc = status_get_sc(src);
+	const status_data* sstatus = status_get_status_data(*src);
+
+	int32 skillratio = 600 + 80 * (skill_lv - 1);
+	if (sc && sc->hasSCE(SC_ENRAGE_RAPTOR)) {
+		skillratio += 300;
+	}
+	skillratio += sstatus->dex; // TODO - unknown scaling [munkrej]
+	RE_LVL_DMOD(100);
+	base_skillratio += -100 + skillratio;
+}
+
+int64 SkillTyphoonWing::splashDamage(block_list* src, block_list* target, uint16 skill_lv, t_tick tick, int32 flag) const {
+	return skill_attack(skill_get_type(getSkillId()), src, src, target, getSkillId(), skill_lv, tick, flag);
+}
